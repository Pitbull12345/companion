#!/usr/bin/env bash
set -euo pipefail

# Re-enter this script inside the Nix development environment if needed.
if ! command -v pytest >/dev/null 2>&1; then
    echo "==> Entering Nix development environment"
    exec nix develop -c ./scripts/check
fi

echo "==> Python tests"
pytest -q -m "not hardware"

echo "==> Python compile check"
python -m compileall -q src

echo "==> Nix checks"
nix flake check

echo "==> All checks passed"

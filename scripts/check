#!/usr/bin/env bash
set -euo pipefail

# Re-enter this script inside the Nix development environment if needed.
if ! command -v pytest >/dev/null 2>&1; then
    echo "==> Entering Nix development environment"
    exec nix develop -c ./scripts/check
fi

echo "==> Python tests"
pytest -q -m "not hardware"

echo "==> Python compile check"
python -m compileall -q src

echo "==> Runtime dependency imports"
python -c "import faster_whisper; import numpy; import ollama; import piper; import silero_vad; import sounddevice; import soxr"
if [[ "$(uname -s)" == "Linux" ]]; then
    command -v pw-cat >/dev/null
fi

echo "==> Nix checks"
nix flake check

echo "==> All checks passed"
